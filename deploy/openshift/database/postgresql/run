#!/bin/bash
set -euo pipefail
if [[ ! -f "$PGDATA/.tuxcmdb-initialized" ]]; then
    if [[ -f "$PGDATA/PG_VERSION" ]]; then
        echo "Incomplete PostgreSQL initialization; inspect/restore the PVC before retrying" >&2
        exit 1
    fi
    password_file="$(mktemp /tmp/postgres-password.XXXXXX)"
    printf '%s\n' "$DB_ADMIN_PASSWORD" > "$password_file"
    initdb --username=postgres --pwfile="$password_file" --auth-local=trust \
        --auth-host=scram-sha-256 --encoding=UTF8 --locale=C.utf8
    rm -f "$password_file"
    printf '\nhost all all all scram-sha-256\n' >> "$PGDATA/pg_hba.conf"
    pg_ctl -D "$PGDATA" -o "-c listen_addresses='' -c unix_socket_directories=/tmp -c logging_collector=off" -w start
    trap 'pg_ctl -D "$PGDATA" -m fast -w stop' EXIT
    psql -h /tmp -U postgres -d postgres --set=ON_ERROR_STOP=1 \
        --set=db_user="$DB_USER" --set=db_password="$DB_PASSWORD" --set=db_name="$DB_NAME" <<'SQL'
CREATE ROLE :"db_user" LOGIN PASSWORD :'db_password';
CREATE DATABASE :"db_name" OWNER :"db_user";
SQL
    pg_ctl -D "$PGDATA" -m fast -w stop
    trap - EXIT
    touch "$PGDATA/.tuxcmdb-initialized"
fi
exec postgres -D "$PGDATA" -c listen_addresses='*' -c unix_socket_directories=/tmp \
    -c logging_collector=off -c log_destination=stderr
